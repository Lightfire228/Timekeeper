{
  "$schema":     "https://schema.tauri.app/config/2",
  "productName": "TimeKeeper",
  "version":     "0.1.0",
  "identifier":  "tk.timekeeper",

  "build": {
    "beforeDevCommand":   "cd ../tk_ui/ && npm run dev",
    "beforeBuildCommand": "cd ../tk_ui/ && npm run build",
    "devUrl":             "http://localhost:1420",
    "frontendDist":       "../tk_ui/build"
  },

  "app": {
    "windows": [
      {
        "title":  "TimeKeeper",
        "width":  800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active":  true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
